# Web3Forms API Key for Contact Form Submissions
# 1. Get your free access key at https://web3forms.com/ (No account or backend required)
# 2. Enter your email (e.g. himanshuchandola.design@gmail.com)
# 3. Paste the generated Access Key below:
VITE_WEB3FORMS_KEY=

# AI Clone Chatbot Configuration ("Talk to My Clone")
# Option A (Recommended, Free): Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=

# Option B: OpenAI API Key from https://platform.openai.com/
OPENAI_API_KEY=
